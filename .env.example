DATABASE_URL="postgresql://sq:sq@localhost:5432/safraquest"
# 32+ caracteres aleatórios (openssl rand -hex 32). Também protege o token da Meta guardado no banco:
# se trocar este valor, será preciso salvar o token da Meta de novo.
SESSION_SECRET="troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres"
APP_URL="http://localhost:3000"          # endereço público, usado nos links das mensagens
CRON_SECRET="dev-cron"                   # protege /api/cron/dispatch
# E-mail (canal padrão). Sem SMTP_HOST, os e-mails só aparecem no log (modo teste).
SMTP_HOST=""                             # Brevo: smtp-relay.brevo.com | Gmail: smtp.gmail.com
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""                             # chave SMTP (Brevo) ou senha de app (Gmail)
MAIL_FROM="SafraQuest <seu-email@exemplo.com>"   # precisa ser um remetente validado no provedor
WHATSAPP_PROVIDER="console"              # reservado: "meta" liga o WhatsApp oficial no futuro
# Só no primeiro deploy (o app cria o usuário Marketing ao iniciar):
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Marketing"
